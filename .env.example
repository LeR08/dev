# Copy this file to .env and adjust as needed. .env is git-ignored.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time by
# Expo — that's fine here since a backend URL isn't secret, but it does mean
# never put an actual secret key behind an EXPO_PUBLIC_ prefix.

# Where the app finds the backend in server/ (see server/README.md for how
# to run it). Point this at your deployed backend once you have one.
EXPO_PUBLIC_BACKEND_URL=http://localhost:4242
