# --- Public site -----------------------------------------------------------
# Canonical origin, used for sitemap/canonical URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (optional) ---------------------------------------------------
# The public site works with none of these set: venue data is read from the
# committed snapshot in data/venues.json. Supabase only backs the write path
# (reviews, reports, admin) which lands in M5.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser. Used by the ETL to write venues.
SUPABASE_SERVICE_ROLE_KEY=

# --- ETL -------------------------------------------------------------------
# Overpass and Nominatim ask for an identifying User-Agent with contact info.
ETL_USER_AGENT="the-smoke-trail/0.1 (+https://example.org; contact@example.org)"
