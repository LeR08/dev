# Copy this file to .env and adjust as needed. .env is git-ignored.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time by
# Expo — fine for the client-side Firebase config below (it's designed to be
# public; Firestore rules are the real access control), but it does mean
# never put an actual secret key behind an EXPO_PUBLIC_ prefix.

# Optional cloud sync (see README's "Accounts & cloud sync" section). Leave
# these blank to keep the app fully local-only — Settings → Account & cloud
# sync then shows a clear "not set up" message instead of a broken sign-in
# form. Fill them in with your own Firebase project's web app config
# (Firebase console → Project settings → General → Your apps) to turn
# accounts and cross-device sync on. These are client config values, not
# secrets — see firebaseApp.ts for why that's fine to ship.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in. Web needs nothing beyond the Firebase config above — it
# signs in via a popup straight against your Firebase project. Native
# (Android/iOS) goes through Google's own SDK
# (@react-native-google-signin/google-signin), which wants the *web* client
# id, not the Android one: Firebase Console → Authentication → Sign-in method
# → Google → "Web SDK configuration" → Web client ID. Leave it blank and the
# Google button on native shows a clear "not set up" state rather than a
# broken one. The Android client id is not read by the app at all — it exists
# in Google Cloud so that the SHA-1 of your signing key is registered.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# NOTE: eas.json rejects an empty string for any env value, so a value that is
# not set yet must be OMITTED from that file rather than set to "". The code
# reads every one of these as `process.env.X || ''`, so an absent variable is
# the supported "not configured" state and the feature hides itself.

# AdMob — the banner's ad unit id, the one shaped with a SLASH. The App ID
# (with a tilde) is not here: it goes into the Android manifest and lives in
# app.config.js instead. Neither is a secret — both ship inside the APK.
# Leave this blank and the app falls back to Google's public TEST unit, which
# is what you want anywhere except a real release: AdMob suspends accounts
# over impressions and clicks a publisher generates on their own app.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=

# PayPal — a hosted donation page opened in the browser. No secret key belongs
# here: this is the public link to your donation page (a PayPal.me link, or a
# Donate button link). Leave it blank and the app hides the donation card
# instead of failing. There is no PayPal subscription any more — the supporter
# subscription goes through Google Play Billing, because Play's Payments
# policy requires it for anything unlocked inside the app.
EXPO_PUBLIC_PAYPAL_DONATE_URL=
