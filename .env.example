# Copy to .env and adjust for local use. Never commit the real .env file.

# Backend API port
PORT=3000

# Secret used to sign JWTs — set a long random value for anything beyond a solo local beta-test
JWT_SECRET=dev-only-secret-do-not-use-in-prod

# Seeded admin account created on first server startup (role=admin, tier=pro).
# mustChangePassword is set to true, so the password below only works once.
ADMIN_SEED_EMAIL=admin@subtrack.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# How often (in hours) the Discord notification job re-checks for imminent charges,
# in addition to the check that always runs once at server startup.
DISCORD_CHECK_INTERVAL_HOURS=6

# --- AI advisor (Basic/Pro: 3 requests/month, VIP: unlimited) ---
# Without this set, POST /api/ai/advice returns 503 instead of crashing.
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-opus-5. Consider a lighter model here
# if AI cost becomes a concern at scale (see CLAUDE.md's V3 self-critique).
ANTHROPIC_MODEL=

# --- Bank connection (VIP-only, GoCardless Bank Account Data, sandbox) ---
# Get sandbox credentials at https://bankaccountdata.gocardless.com/
# Without these set, /api/bank/* routes return 503 instead of crashing.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Must point at this backend's public callback route.
GOCARDLESS_REDIRECT_URI=http://localhost:3000/api/bank/callback
# Where to send the user's browser back to after the bank redirect completes.
FRONTEND_URL=http://localhost:5173

# 32-byte key (base64) used to encrypt bank connection tokens at rest (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without this set, all /api/bank/* routes return 503 rather than storing anything in plaintext.
BANK_TOKEN_ENCRYPTION_KEY=
