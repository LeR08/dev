# Copy to .env (git-ignored) and fill in. Never commit real values.

# Kraken API key: permissions "Query" + "Trade" ONLY. Withdrawals MUST be disabled.
# Optional: restrict the key to your IP address in Kraken settings.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Etherscan free-tier key (on-chain flows for the smart-money agent).
ETHERSCAN_API_KEY=

# SEC EDGAR requires a descriptive User-Agent: "<name> <email>".
EDGAR_USER_AGENT=tradebot-local-research your-email@example.com

# IBKR live account id (e.g. U1234567). Required before "live on ibkr".
# Paper accounts start with "D" and need no variable here.
IBKR_LIVE_ACCOUNT=

# Optional overrides
# TRADEBOT_HOME=/path/where/data-and-logs-live
# TRADEBOT_CONFIG_DIR=/path/to/config
