# Copy to .env and adjust for local use. Never commit the real .env file.

# Backend API port
PORT=3000

# Secret used to sign JWTs — set a long random value for anything beyond a solo local beta-test
JWT_SECRET=dev-only-secret-do-not-use-in-prod

# Seeded admin account created on first server startup (role=admin, tier=pro).
# mustChangePassword is set to true, so the password below only works once.
ADMIN_SEED_EMAIL=admin@subtrack.local
ADMIN_SEED_PASSWORD=ChangeMe123!

# How often (in hours) the Discord notification job re-checks for imminent charges,
# in addition to the check that always runs once at server startup.
DISCORD_CHECK_INTERVAL_HOURS=6
