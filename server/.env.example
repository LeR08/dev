# Copy this file to .env and fill in your own real keys.
# .env is git-ignored — never commit real secret keys.

# --- Server ---
PORT=4242

# Where the browser sends the user back after checkout/approval. Point these
# at whatever your app can handle — a web landing page, or a deep link like
# tally://subscription/success (set up via expo-linking) once you have one.
APP_SUCCESS_URL=https://example.com/subscription/success
APP_CANCEL_URL=https://example.com/subscription/cancel

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
# Secret key — start in TEST mode (sk_test_...). Never share, never commit.
STRIPE_SECRET_KEY=sk_test_replace_me
# Price ID for the monthly premium plan (Product catalog > Add product > Pricing).
STRIPE_PRICE_ID=price_replace_me
# Webhook signing secret. For local dev: `stripe listen --forward-to localhost:4242/api/stripe/webhook`
# prints one; for production, create the endpoint in Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- PayPal (https://developer.paypal.com/dashboard/) ---
# Sandbox app credentials to start (Dashboard > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com once live.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Billing plan id for the monthly premium subscription (Dashboard > Products & Plans).
PAYPAL_PLAN_ID=P-replace_me
# Webhook ID (Dashboard > Webhooks > your webhook > Webhook ID) — used to verify
# that incoming webhook calls really came from PayPal.
PAYPAL_WEBHOOK_ID=replace_me
